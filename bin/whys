#!/usr/bin/env python3
"""whys: mechanical checks for Whys statement files.

  whys lint <file-or-dir>
  whys cover <whys-file-or-dir> <plan.md>
  whys miss <project> <statement-id> <kind> <note>
  whys kinds
"""
import datetime
import os
import re
import sys
from dataclasses import dataclass, field

CANDIDATE = re.compile(r"^(✗ |\? )?(S[0-9.]\S*)\s+(.*)$")
ID = re.compile(r"^S\d+(\.\d+)*$")
TAG = re.compile(r"\[(owner|delegated)\]")
KEYWORD = re.compile(r"(?<!\S)#(\w+)")
REPLACED = re.compile(r"→\s*(S\d+(?:\.\d+)*)")


@dataclass
class Statement:
    id: str
    depth: int
    state: str  # live | rejected | open
    tag: str | None
    tags: list = field(default_factory=list)
    replaced_by: str | None = None
    file: str = ""
    line: int = 0


def md_files(path):
    if os.path.isdir(path):
        return sorted(os.path.join(path, f) for f in os.listdir(path) if f.endswith(".md"))
    return [path]


def parse(path, errors=None):
    """Parse one file. Errors go to `errors` as (file, line, text)."""
    errors = [] if errors is None else errors
    out, allowed = [], None
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    fence = False
    for n, raw in enumerate(lines, 1):
        line = raw.strip()
        if line.startswith("```"):
            fence = not fence
            continue
        if fence:
            continue
        if line.startswith("Tags:"):
            allowed = set(KEYWORD.findall(line))
            continue
        m = CANDIDATE.match(line)
        if not m:
            continue
        prefix, sid, rest = m.groups()
        if not ID.match(sid):
            errors.append((path, n, f"bad id {sid}"))
            continue
        rejected = prefix == "✗ " or rest.startswith("✗ ")
        state = "open" if prefix == "? " else "rejected" if rejected else "live"
        tags = TAG.findall(rest)
        if state != "open" and len(tags) != 1:
            errors.append((path, n, "missing tag" if not tags else "more than one tag"))
        r = REPLACED.search(rest)
        out.append(Statement(sid, sid.count(".") + 1, state, tags[0] if tags else None,
                             KEYWORD.findall(rest), r.group(1) if r else None, path, n))
    if allowed is not None:
        for s in out:
            for t in s.tags:
                if t not in allowed:
                    errors.append((path, s.line, f"unknown tag #{t}"))
    return out


def load(path, errors):
    stmts = []
    for f in md_files(path):
        stmts += parse(f, errors)
    return stmts


def lint(path):
    if not os.path.exists(path):
        print(f"{path}: not found")
        return 1
    errors = []
    stmts = load(path, errors)
    seen = {}
    for s in stmts:
        if s.id in seen:
            errors.append((s.file, s.line, f"duplicate {s.id}"))
        seen.setdefault(s.id, s)
    for s in stmts:
        parent = s.id.rsplit(".", 1)[0] if "." in s.id else None
        if parent and parent not in seen:
            errors.append((s.file, s.line, f"parent {parent} missing"))
        if s.replaced_by and s.replaced_by not in seen:
            errors.append((s.file, s.line, f"replacement {s.replaced_by} missing"))
    n_open = sum(s.state == "open" for s in stmts)
    depth = max((s.depth for s in stmts), default=0)
    status = "open" if n_open or not stmts else "closed"
    print(f"status={status} depth={depth} open={n_open} statements={len(stmts)}")
    multi = os.path.isdir(path)
    for f, n, text in sorted(errors, key=lambda e: (e[0], e[1])):
        print(f"{os.path.basename(f) + ':' if multi else ''}L{n}: {text}")
    return 1 if errors else 0


TASK = re.compile(r"^###\s+Task\s+(\d+)")
CITES = re.compile(r"^\*\*Statements:\*\*(.*)$")
CITED_ID = re.compile(r"S\d+(?:\.\d+)*")


def cover(whys_path, plan_path):
    for p in (whys_path, plan_path):
        if not os.path.exists(p):
            print(f"{p}: not found")
            return 1
    stmts = {s.id: s for s in load(whys_path, [])}
    tasks = {}
    current = None
    with open(plan_path, encoding="utf-8") as fh:
        for line in fh:
            m = TASK.match(line.strip())
            if m:
                current = m.group(1)
                tasks[current] = []
                continue
            c = CITES.match(line.strip())
            if c and current:
                tasks[current] += CITED_ID.findall(c.group(1))
    problems = []
    cited = {i for ids in tasks.values() for i in ids}
    for s in stmts.values():
        if s.state == "live" and s.id not in cited:
            problems.append(f"uncited {s.id}")
    for t, ids in tasks.items():
        if not ids:
            problems.append(f"task {t} cites nothing")
        for i in ids:
            if i not in stmts:
                problems.append(f"task {t} cites unknown {i}")
    for p in problems:
        print(p)
    return 1 if problems else 0


HERE = os.path.dirname(os.path.realpath(__file__))
GAPS = os.path.join(HERE, "..", "skills", "drill", "gaps.md")
GAP_LINE = re.compile(r"^- ([\w-]+): (.+)$")


def miss_log():
    home = os.environ.get("WHYS_HOME") or os.path.join(os.path.expanduser("~"), ".claude", "whys")
    return os.path.join(home, "misses.md")


def miss(project, sid, kind, note):
    if not ID.match(sid):
        print(f"bad id {sid}")
        return 1
    path = miss_log()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    new = not os.path.exists(path)
    with open(path, "a", encoding="utf-8") as fh:
        if new:
            fh.write("# Whys miss log\n# date | project | statement | kind | note\n")
        clean = lambda v: " ".join(v.replace("|", "/").split())
        fh.write(f"{datetime.date.today()} | {clean(project)} | {sid} | {clean(kind)} | {clean(note)}\n")
    return 0


def kinds():
    probes, counts = {}, {}
    with open(GAPS, encoding="utf-8") as fh:
        for line in fh:
            m = GAP_LINE.match(line.strip())
            if m:
                probes[m.group(1)] = m.group(2)
                counts[m.group(1)] = 0
    if os.path.exists(miss_log()):
        with open(miss_log(), encoding="utf-8") as fh:
            for line in fh:
                parts = [p.strip() for p in line.split("|")]
                if line.startswith("#") or len(parts) != 5:
                    continue
                counts[parts[3]] = counts.get(parts[3], 0) + 1
                probes.setdefault(parts[3], f"Learned from misses, e.g. {parts[4]}")
    for k in sorted(counts, key=lambda k: -counts[k]):
        print(f"{k} {counts[k]}  {probes[k]}")
    return 0


def main(argv):
    if len(argv) == 2 and argv[0] == "lint":
        return lint(argv[1])
    if len(argv) == 3 and argv[0] == "cover":
        return cover(argv[1], argv[2])
    if len(argv) == 5 and argv[0] == "miss":
        return miss(*argv[1:])
    if argv == ["kinds"]:
        return kinds()
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
